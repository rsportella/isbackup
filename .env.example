# Copie para .env (ou rode "isbackup init") e preencha com as senhas reais.
# Os nomes aqui precisam bater com os ${VAR} usados em config.yaml.
# Este arquivo (.env) nunca deve ser commitado - ja esta no .gitignore.

DB_PRODUCAO_PASSWORD=
DB_STAGING_PASSWORD=

# Gerada automaticamente (CLI "isbackup encrypt" ou pela interface web) na
# primeira vez que uma senha for cifrada direto no config.yaml. Nao mude nem
# apague depois de ter senhas cifradas - sem ela elas nao podem ser lidas.
# ISBACKUP_ENCRYPTION_KEY=
