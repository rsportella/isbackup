{
  "name": "isbackup",
  "version": "1.0.0",
  "description": "Backups de MySQL/MariaDB e de arquivos via SFTP/FTP, configurados num YAML, agendados no cron e acompanhados por um painel web local",
  "keywords": [
    "backup",
    "mysql",
    "mariadb",
    "mysqldump",
    "sftp",
    "ftp",
    "cron",
    "dashboard"
  ],
  "author": "Rodolfo Portella",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "isbackup": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "ui": "node dist/cli.js ui",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^5.4.1",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
